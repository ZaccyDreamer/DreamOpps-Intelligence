generator client {
  provider = "prisma-client-js"
  engineType = "client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}
enum OpportunityStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  ARCHIVED
}
enum VerificationStatus {
  UNCHECKED
  IN_REVIEW
  VERIFIED
  NEEDS_ATTENTION
}
enum SourceCredibility {
  UNKNOWN
  COMMUNITY
  OFFICIAL
}
enum ApplicationStatus {
  INTERESTED
  PREPARING
  APPLIED
  INTERVIEWING
  OFFER
  NOT_PROCEEDING
}
enum DeliveryFormat {
  REMOTE
  HYBRID
  IN_PERSON
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile StudentProfile?
  saved SavedOpportunity[]
  applications Application[]
  preferences NotificationPreference?
  sessions Session[]
  @@index([role])
}

model StudentProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyLevel String?
  fieldOfStudy String?
  country String?
  nationality String?
  academicRequirements Json?
  preferredCategories String[] @default([])
  preferredLocations String[] @default([])
  preferredFormats String[] @default([])
  interests String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id String @id @default(cuid())
  slug String @unique
  title String
  provider String
  description String
  category String
  eligibleCountries String[] @default([])
  locations String[] @default([])
  studyLevels String[] @default([])
  fields String[] @default([])
  eligibility Json?
  requiredDocuments String[] @default([])
  fundingAmount Decimal? @db.Decimal(14, 2)
  fundingCurrency String?
  fundingType String?
  format DeliveryFormat?
  applicationUrl String
  publishedAt DateTime?
  deadline DateTime?
  deadlineTimezone String?
  status OpportunityStatus @default(DRAFT)
  sourceCredibility SourceCredibility @default(UNKNOWN)
  verificationStatus VerificationStatus @default(UNCHECKED)
  lastSourceCheckAt DateTime?
  demo Boolean @default(false)
  sources OpportunitySource[]
  savedBy SavedOpportunity[]
  applications Application[]
  events VerificationEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, deadline])
  @@index([category, status])
  @@index([verificationStatus])
  @@index([provider])
}

model OpportunitySource {
  id String @id @default(cuid())
  opportunityId String
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  url String
  name String?
  retrievedAt DateTime?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  failureReason String?
  authorized Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([opportunityId, url])
  @@index([retrievedAt])
}

model SavedOpportunity {
  userId String
  opportunityId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@id([userId, opportunityId])
  @@index([opportunityId])
}

model Application {
  id String @id @default(cuid())
  userId String
  opportunityId String
  status ApplicationStatus @default(INTERESTED)
  notes String?
  appliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
  @@index([userId, status])
}

model VerificationEvent {
  id String @id @default(cuid())
  opportunityId String
  actorUserId String?
  action String
  details Json?
  checkedAt DateTime @default(now())
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([opportunityId, checkedAt])
}

model NotificationPreference {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadlineReminders Boolean @default(true)
  recommendationUpdates Boolean @default(true)
  emailEnabled Boolean @default(false)
  timezone String?
  updatedAt DateTime @updatedAt
}

model Session {
  sid String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([userId])
}
